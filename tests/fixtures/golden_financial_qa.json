    {
      "id": "QA-001",
      "category": "factual_lookup",
      "query": "What was Apple's total net sales in fiscal year 2024?",
      "ticker": "AAPL",
      "expected_status": "completed",
      "expected_grounding": "grounded",
      "expected_facts": [
        {
          "metric": "Total net sales",
          "period": "FY2024",
          "raw_value": "391,035",
          "currency": "USD",
          "scale": "millions"
        }
      ],
      "expected_calculations": [],
      "expected_citations": ["C1"],
      "expected_keywords": ["$391,035", "million", "[C1]"]
    },
    {
      "id": "QA-002",
      "category": "arithmetic_calculation",
      "query": "What was the operating income for Apple in FY2024 based on total net sales and operating expenses?",
      "ticker": "AAPL",
      "expected_status": "completed",
      "expected_grounding": "grounded",
      "expected_facts": [
        {
          "metric": "Total net sales",
          "period": "FY2024",
          "raw_value": "391,035",
          "currency": "USD",
          "scale": "millions"
        },
        {
          "metric": "Total operating expenses",
          "period": "FY2024",
          "raw_value": "267,800",
          "currency": "USD",
          "scale": "millions"
        }
      ],
      "expected_calculations": [
        {
          "operation": "subtract",
          "expected_result": "123235.00",
