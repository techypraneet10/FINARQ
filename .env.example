# ==============================================================================
# FINARQ - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Financial Document Intelligence & Verified Reasoning Platform
# ==============================================================================
# Copy this file to '.env' for local development.
# NEVER commit real passwords, JWT secrets, private keys, or API tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Environment: 'development', 'testing', 'staging', 'production'
APP_ENVIRONMENT=development
APP_NAME="FINARQ"
APP_VERSION=0.1.0
APP_GIT_SHA=dev-local
APP_BUILD_TIMESTAMP=2026-08-24T00:00:00Z
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SHUTDOWN_TIMEOUT_SECONDS=15.0
# JSON array of allowed CORS origin URLs
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8501"]

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: 'json' (mandatory for prod/staging) or 'text' (human-readable for dev)
LOG_FORMAT=text

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_rag_db
DB_USER=postgres
DB_PASSWORD=postgres_local_password
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_TIMEOUT_SECONDS=30.0
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false
# DB_URL overrides host/port/name/user/pwd if provided (e.g. postgresql+asyncpg://...)
# DB_URL=

# ------------------------------------------------------------------------------
# 4. REDIS / CACHE / QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_SSL=false
REDIS_TIMEOUT_SECONDS=5.0
REDIS_DEFAULT_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE CONFIGURATION (S3 Compatible / MinIO / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ADAPTER=filesystem
STORAGE_LOCAL_DIR=./data/storage
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_DOCUMENTS=financial-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 6. VECTOR DATABASE CONFIGURATION (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME=financial_chunks
QDRANT_USE_HTTPS=false
QDRANT_TIMEOUT_SECONDS=10.0
# QDRANT_LOCATION=":memory:" or local folder path for testing/dev
# QDRANT_LOCATION=

# ------------------------------------------------------------------------------
# 7. LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: 'openai', 'anthropic', 'gemini', 'ollama', 'mock'
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-financial-llm
LLM_API_KEY=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_FACTOR=1.5
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 8. EMBEDDING PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: 'openai', 'gemini', 'huggingface', 'mock'
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=mock-text-embedding
EMBEDDING_API_KEY=""
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=3
EMBEDDING_CIRCUIT_BREAKER_ENABLED=true

# ------------------------------------------------------------------------------
# 9. ASYNCHRONOUS WORKER CONFIGURATION
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_BATCH_SIZE=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 10. AUTHENTICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# In production, JWT secret must be >= 32 random characters generated cryptographically
SECURITY_JWT_SECRET_KEY=financial-rag-dev-secret-key-32-chars-min-len-xyz123
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_ISSUER=financial-rag-platform
SECURITY_JWT_AUDIENCE=financial-rag-api
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=7
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_AUTH_DISABLED_DEV=false
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_AUTH_PER_MINUTE=10
SECURITY_RATE_LIMIT_UPLOAD_PER_MINUTE=20
SECURITY_RATE_LIMIT_ANSWERS_PER_MINUTE=30
SECURITY_RATE_LIMIT_RETRIEVAL_PER_MINUTE=60
SECURITY_RATE_LIMIT_DEFAULT_PER_MINUTE=120
SECURITY_MAX_FAILED_LOGINS=5
SECURITY_LOCKOUT_DURATION_SECONDS=300

# ------------------------------------------------------------------------------
# 11. INGESTION, PARSER & CHUNKING CONFIGURATION
# ------------------------------------------------------------------------------
INGESTION_MAX_FILE_SIZE_BYTES=52428800
INGESTION_MAX_WORKERS=4
PARSER_OCR_ENABLED=true
PARSER_OCR_PROVIDER=mock
CHUNKING_MAX_CHUNK_SIZE=1000
CHUNKING_CHUNK_OVERLAP=150
CHUNKING_PRESERVE_TABLES=true
CHUNKING_MAX_TABLE_TOKENS=2000

# ------------------------------------------------------------------------------
# 12. RETRIEVAL & RERANKING CONFIGURATION
# ------------------------------------------------------------------------------
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RETRIEVAL_CANDIDATE_POOL_SIZE=50
RETRIEVAL_RERANK_TOP_K=20
RETRIEVAL_FINAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANKER_PROVIDER=mock
RETRIEVAL_TIMEOUT_SECONDS=10.0
